# Skopiuj jako .env w katalogu projektu i uzupełnij wartości.
#
# URL: Supabase → Project Settings → API → Project URL
# Tylko ten adres (bez /rest/v1). Otwarcie go w przeglądarce zwraca
# {"error":"requested path is invalid"} — to normalne, nie jest to błąd konfiguracji.
#
# Klucz: ten sam ekran → "anon" "public" (NIE service_role w aplikacji React)

VITE_SUPABASE_URL=https://twoj-ref.supabase.co
VITE_SUPABASE_ANON_KEY=twoj_klucz_anon_public
